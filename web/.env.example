# ── Server-side keys (NEVER prefix with NEXT_PUBLIC_) ──────────────
# These are read only on the server. Configure the real values in the
# Vercel dashboard (Project → Settings → Environment Variables), not here.

# Gemini API key used by the AI proposal generator Route Handler.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Secret used to sign JWT access tokens. Generate a strong random string.
JWT_SECRET="MY_JWT_SECRET"

# The URL where this app is hosted. Used for self-referential links and
# OAuth callbacks.
APP_URL="MY_APP_URL"

