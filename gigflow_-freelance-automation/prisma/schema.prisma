generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String?  @unique
  firstName         String?
  lastName          String?
  name              String?  // Kept for backward compatibility/OAuth
  bio               String?
  passwordHash      String?  // null for OAuth-only users
  isEmailVerified   Boolean  @default(false)
  termsAccepted     Boolean  @default(false)
  marketingEmails   Boolean  @default(false)
  verificationToken String?  @unique
  verificationExpiry DateTime?
  resetToken        String?  @unique
  resetTokenExpiry  DateTime?

  // OAuth
  googleId          String?  @unique

  skills            Skill[]
  refreshTokens     RefreshToken[]
  userGigs          UserGig[]
  documents         UserDocument[]
  agentRuns         AgentRun[]
  applications      Application[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  rememberMe Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Skill {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}

model Opportunity {
  id             String   @id @default(uuid())
  platform       String
  externalId     String?
  canonicalUrl   String?
  title          String
  description    String
  budgetMin      Float?
  budgetMax      Float?
  currency       String?
  requiredSkills String?
  location       String?
  isRemote       Boolean?
  publishedAt    DateTime?
  scrapedAt      DateTime @default(now())
  sourceMetadata String?
  fingerprint    String   @unique

  tasks          AgentTask[]
  applications   Application[]

  @@index([platform])
  @@index([publishedAt])
  @@index([fingerprint])
}

model UserDocument {
  id            String   @id @default(uuid())
  userId        String
  name          String
  type          String   // PROPOSAL_GUIDE, PORTFOLIO, RESUME, GENERAL
  storageKey    String?
  extractedText String?
  status        String   @default("READY")
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AgentRun {
  id          String      @id @default(uuid())
  userId      String
  instruction String
  planJson    String?
  status      String      @default("DRAFT")
  targetCount Int?
  startedAt   DateTime    @default(now())
  completedAt DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       AgentTask[]

  @@index([userId, startedAt])
}

model AgentTask {
  id              String      @id @default(uuid())
  agentRunId      String
  opportunityId   String
  score           Float?
  recommendation  String?     // APPLY, REVIEW, SKIP
  analysisJson    String?     // JSON: fit, reasons, risks, matchedSkills, missingSkills
  proposal        String?
  proposalVersion Int         @default(1)
  proposalStatus  String      @default("DRAFT") // DRAFT, READY, USER_EDITED, APPROVED, REJECTED, SUBMITTED, FAILED
  userApprovedAt  DateTime?
  submittedAt     DateTime?
  outcome         String?

  agentRun        AgentRun    @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, opportunityId])
  @@index([opportunityId])
}

model Application {
  id            String      @id @default(uuid())
  userId        String
  opportunityId String
  proposal      String
  status        String      @default("DRAFT") // DRAFT, APPROVED, SUBMITTED, ACTION_REQUIRED, VIEWED, INTERVIEW, REJECTED, WON, WITHDRAWN
  externalUrl   String?
  submittedAt   DateTime?
  outcome       String?

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([userId, opportunityId])
}

model OpportunitySource {
  id          String    @id @default(uuid())
  key         String    @unique
  displayName String
  type        String    // scraper, rss, api, scrapling_service
  enabled     Boolean   @default(false)
  configJson  String?
  lastRunAt   DateTime?
  lastStatus  String?
}

// ── Legacy Models (Kept for backward compatibility) ────────
model Gig {
  id             String   @id @default(uuid())
  title          String
  description    String
  budget         String?
  platform       String   @default("Mostaql")
  url            String   @unique
  requiredSkills String?
  scrapedAt      DateTime @default(now())
  matchScore     Float?

  userGigs       UserGig[]
}

model UserGig {
  id        String   @id @default(uuid())
  userId    String
  gigId     String
  status    String   @default("NEW")
  proposal  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([userId, gigId])
  @@index([userId])
  @@index([gigId])
}
